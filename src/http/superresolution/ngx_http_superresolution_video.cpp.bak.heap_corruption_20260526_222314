  u_char *curr = newbuf;
  ngx_int_t copied = 0;
  size_t to_copy_bytes;
  t = tmp->next;
  
  while(copied <= total_sz && t!=NULL){
    to_copy_bytes = t->buf->last - t->buf->pos;
    ngx_memcpy(curr, t->buf->pos, to_copy_bytes);
    copied += to_copy_bytes;
    curr += to_copy_bytes;
    t = t->next;
