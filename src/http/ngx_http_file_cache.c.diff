< typedef struct {
<   ngx_int_t width;
<   ngx_int_t height;
< } ngx_dimensions_t;
< 
< 
< ngx_dimensions_t
< ngx_http_file_cache_get_media_dimensions(ngx_str_t resolution, ngx_log_t *log)
< {
<   u_char *m, *n;
<   m = n = resolution.data;
<   ngx_dimensions_t dim;
<   dim.width = -1;
<   dim.height = -1;
<   
<   for (size_t i=0; i < resolution.len; i++){
<     if(m != NULL && (*m == 'x' || *m == 'X')){
<       dim.width = ngx_atoi(n, m-n);
<       n = m+1;
<     }
<     ++m;
<   }
< 
<   if (m>n){
<     dim.height = ngx_atoi(n, m-n);
<   }  
<   return dim;
< }
< 
