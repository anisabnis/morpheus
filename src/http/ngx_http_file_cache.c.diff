< void
< ngx_http_file_cache_use_alt_key(ngx_http_cache_t *c, ngx_uint_t index)
< {
<   if (c->alt_keys != NULL){
<     ngx_str_t *alt = c->alt_keys->elts;
<     ngx_memcpy(c->key, alt[index].data, NGX_HTTP_CACHE_KEY_LEN);
<     ngx_memcpy(c->alt_key, alt[index].data, NGX_HTTP_CACHE_KEY_LEN);
<   }
< 
<   if (c->alt_crcs != NULL){
<     c->crc32 = c->alt_crcs[index];
<     c->alt_crc32 = c->alt_crcs[index];
<   }
<   
<   if (c->header_start_alternatives != NULL){
<     c->header_start = c->header_start_alternatives[index];
<   }
< }
< 
