< void
< ngx_http_file_cache_create_resolved_keys(ngx_http_request_t *r)
< {
< 
<     size_t             len;
<     ngx_str_t         *key;
<     ngx_str_t         *resolvable_media;
<     ngx_uint_t         i;
<     ngx_http_cache_t  *c;
< 
<     c = r->cache;
< 
<     c->resolvable_crcs           = ngx_pcalloc(r->pool, r->headers_in.resolvable_objects->nelts*sizeof(uint32_t));
<     c->header_start_resolvables  = ngx_pcalloc(r->pool, r->headers_in.resolvable_objects->nelts*sizeof(size_t));
<     c->resolvable_keys           = ngx_array_create(r->pool, 4, sizeof(ngx_str_t));
< 
<     
<     key = c->keys.elts;
<     resolvable_media = r->headers_in.resolvable_objects->elts;
<     
<     for (size_t j=0; j < r->headers_in.resolvable_objects->nelts; j++){
< 
<       ngx_md5_t          md5;
<       len = 0;
< 
<       ngx_int_t ret = ngx_http_file_cache_check_if_valid_resolution(r, j);
< 
<       if (ret != NGX_OK)
< 	continue;
<             
<       ngx_md5_init(&md5);
<       ngx_crc32_init(c->resolvable_crcs[j]);    
<         
<       for (i = 0; i < c->keys.nelts; i++) {
<         ngx_log_debug2(NGX_LOG_DEBUG_HTTP, r->connection->log, 0,
<                        "http resolvable cache key: \"%V\" \"%d\"", &key[i], key[i].len);
< 
<         len += key[i].len;
< 	ngx_crc32_update(&c->resolvable_crcs[j], key[i].data, key[i].len);
<         ngx_md5_update(&md5, key[i].data, key[i].len);
< 	break;
<       }
< 
<       u_char *t = (u_char *) malloc(resolvable_media[j].len);
<       memcpy(t, resolvable_media[j].data, resolvable_media[j].len);
<       ngx_md5_update(&md5, t, resolvable_media[j].len); 
<       ngx_crc32_update(&c->resolvable_crcs[j], t, resolvable_media[j].len);
<       ngx_crc32_final(c->resolvable_crcs[j]);
< 
<       ngx_str_t *tmp = ngx_array_push(c->resolvable_keys);
<       tmp->data = (u_char *) ngx_pcalloc(r->pool, NGX_HTTP_CACHE_KEY_LEN);
<       tmp->len  = NGX_HTTP_CACHE_KEY_LEN;
<       ngx_md5_final(tmp->data, &md5);
<      
<       ngx_log_debug2(NGX_LOG_DEBUG_HTTP, r->connection->log, 0,
< 		     "http resolvable object key: \"%p\" \"%d\"", tmp->data, ret);
<       
<       len += resolvable_media[j].len;
<       c->header_start_resolvables[j] = sizeof(ngx_http_file_cache_header_t) 
< 	+ sizeof(ngx_http_file_cache_key) + len + 1;
< 
<       free(t);            
<     }
< }
